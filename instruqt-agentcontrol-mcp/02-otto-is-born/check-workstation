#!/bin/sh
#
# Assertions are deliberately loose on anything an agent gets to choose freely
# (display names, prompt wording, which flavour of the model-config key it
# picks) and strict on the things downstream challenges depend on: the config
# key, the variation key, and the fact that something is actually being served.
#

#
# NOTE: this is /bin/sh, which is dash on Ubuntu, and dash's builtin `echo`
# interprets backslash escapes. `echo "$JSON" | jq` therefore turns escaped \n
# inside JSON strings into real newlines and jq fails with "control characters
# must be escaped". Always `printf '%s' "$JSON" | jq`.
CONFIG_URL="https://app.launchdarkly.com/api/v2/projects/${LD_PROJECT_KEY}/ai-configs/otto-assistant"

# 1. The otto-assistant Config exists. Retry briefly: the learner may click
#    Check while the agent's last write is still settling.
i=0
while [ $i -lt 5 ]; do
  CONFIG=$(curl -s -X GET "$CONFIG_URL" \
    -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
    -H 'LD-API-Version: beta')
  [ "$(printf '%s' "$CONFIG" | jq -r '.key // "null"')" = "otto-assistant" ] && break
  i=$((i + 1))
  sleep 2
done

if [ "$(printf '%s' "$CONFIG" | jq -r '.key // "null"')" != "otto-assistant" ]; then
  fail-message "No Config with key **otto-assistant** exists yet. Ask Claude Code for it using the prompt under **Ask for Otto's Config** — and if it used a different key, tell it to use otto-assistant exactly."
  exit 1
fi

if [ "$(printf '%s' "$CONFIG" | jq -r '.mode // ""')" != "completion" ]; then
  fail-message "The **otto-assistant** Config isn't in completion mode. Ask Claude Code to recreate it in completion mode. Mode is fixed at creation time and can't be changed afterward."
  exit 1
fi

# 2. The otto-born variation exists and runs some flavour of Haiku 4.5. The
#    model-config key has several valid spellings (Bedrock.anthropic.claude-
#    haiku-4-5-20251001-v1:0, Anthropic.claude-haiku-4-5, ...) so match on the
#    family rather than one exact string.
VARIATION_MODEL=$(printf '%s' "$CONFIG" | jq -r '.variations[]? | select(.key=="otto-born") | .modelConfigKey // ""')
if [ -z "$VARIATION_MODEL" ]; then
  fail-message "Otto has no variation with key **otto-born**. Ask Claude Code to add it, using that exact key — the next challenge attaches a judge to it by key."
  exit 1
fi
if ! printf '%s' "$VARIATION_MODEL" | grep -qi 'haiku-4-5'; then
  fail-message "Otto's variation is running \`${VARIATION_MODEL}\`, not Claude Haiku 4.5. Ask Claude Code to switch it to anthropic.claude-haiku-4-5-20251001-v1:0."
  exit 1
fi

# 3. The variation has a non-empty system message. Wording isn't asserted.
SYSTEM_MSG=$(printf '%s' "$CONFIG" | jq -r '.variations[]? | select(.key=="otto-born") | .messages[]? | select(.role=="system") | .content' | head -c 1)
if [ -z "$SYSTEM_MSG" ]; then
  fail-message "Otto's variation has no system message. Ask Claude Code to add the starter prompt from the lab instructions."
  exit 1
fi

# 4. The `test` environment is actually serving otto-born.
#
# READ THIS BEFORE CHANGING THE JQ. The two AI Config endpoints identify a
# variation differently, and conflating them is what broke the first version of
# this check:
#
#   GET  /ai-configs/{key}            variations carry `key` AND `_id`
#   GET  /ai-configs/{key}/targeting  variations carry `_id`, `name`, `value`
#                                     and NO `key`; every reference to one
#                                     (fallthrough, rules, rollout) is an
#                                     INTEGER INDEX into that array
#   PATCH /ai-configs/{key}/targeting writes take `variationId`, a string
#
# So you write by ID and read back an index. The old version compared an `_id`
# from the config endpoint against an `_id` from the targeting endpoint; those
# are not documented to be the same identifier space, and the comparison could
# fail while the targeting was perfectly correct.
#
# Resolving otto-born now means finding its POSITION in the targeting array,
# which has no key to match on. Join on `_id`, falling back to `name` — both
# endpoints describe the same underlying variation, so at least one holds.
# Matching `name` is not asserting a particular display name; it's only used to
# line the two arrays up.
#
# Docs: launchdarkly.com/docs/api/agent-control/get-ai-config-targeting
TARGETING=$(curl -s -X GET \
  "${CONFIG_URL}/targeting" \
  -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
  -H 'LD-API-Version: beta')

if ! printf '%s' "$TARGETING" | jq -e . >/dev/null 2>&1; then
  fail-message "Couldn't read otto-assistant's targeting from LaunchDarkly. That's a lab problem rather than anything you did — tell your operator."
  exit 1
fi

if [ "$(printf '%s' "$TARGETING" | jq -r 'has("environments") and (.environments | has("test"))')" != "true" ]; then
  ENVS=$(printf '%s' "$TARGETING" | jq -r '.environments // {} | keys | join(", ")')
  fail-message "otto-assistant has no **test** environment targeting. Environments found: \`${ENVS:-none}\`. This is a lab setup problem — tell your operator."
  exit 1
fi

BORN_IDX=$(jq -n --argjson cfg "$CONFIG" --argjson tgt "$TARGETING" '
  first($cfg.variations[]? | select(.key=="otto-born")) as $v
  | [ ($tgt.variations // []) | to_entries[]
      | select(.value._id == $v._id or .value.name == $v.name)
      | .key ]
  | first // empty' 2>/dev/null)

FALLTHROUGH_IDX=$(printf '%s' "$TARGETING" | jq -r '.environments.test.fallthrough.variation // empty')
FALLTHROUGH_ROLLOUT=$(printf '%s' "$TARGETING" | jq -c '.environments.test.fallthrough.rollout // empty')

if [ -z "$BORN_IDX" ]; then
  fail-message "Couldn't line up the **otto-born** variation with otto-assistant's targeting. Ask Claude Code to show you the variations on otto-assistant and confirm one is keyed exactly \`otto-born\`."
  exit 1
fi

# A rollout on the fallthrough is a different failure from the wrong variation,
# and it has a different fix. Chapter 5's solve leaves a 10/90 split here, so a
# learner who skipped ahead and came back lands in exactly this state.
if [ -z "$FALLTHROUGH_IDX" ] && [ -n "$FALLTHROUGH_ROLLOUT" ]; then
  fail-message "Otto's **Test** default rule is serving a percentage rollout rather than a single variation, so this chapter's check can't confirm otto-born is being served. Ask Claude Code to set the default rule in Test to serve otto-born on its own."
  exit 1
fi

if [ "$FALLTHROUGH_IDX" != "$BORN_IDX" ]; then
  fail-message "Otto's **Test** environment isn't serving the otto-born variation, so the app gets nothing back. Ask Claude Code to set the default rule in the Test environment to serve otto-born."
  exit 1
fi

# 5. The app is wired to AgentControl.
#
# This is PRE-BAKED into the VM image — the learner never pastes it. If this
# fires, the image is wrong, not the learner. Keep the assertion anyway: a
# silently unwired app makes every later chapter fail in confusing ways.
if ! grep -q 'ai_client.completion_config(OTTO_CONFIG_KEY' /opt/ld/ai-configs-intro/app/server.py; then
  fail-message "The ToggleWear app isn't wired to AgentControl, which is a problem with the lab image rather than anything you did. Tell your operator that \`server.py\` shipped without the Challenge 01 block."
  exit 1
fi

# 6. Otto actually answers.
#
# Everything above only proves the Config exists and the right code is on disk.
# This chapter's stated goal is "Otto says his first words", so ask him. Without
# this the check goes green while Bedrock is misconfigured and the learner is
# told they succeeded at something visibly broken.
#
# Costs one real model call per Check press. That is the point.
CHAT=$(curl -s --max-time 45 -X POST 'http://localhost:3000/chat' \
  -H 'Content-Type: application/json' \
  --data-raw '{"message":"Got any t-shirts?","user_tier":"free","session_id":"check-workstation"}')

if [ -z "$CHAT" ]; then
  fail-message "The ToggleWear app didn't respond at all. In the terminal, run \`service togglewear restart\`, wait a few seconds, and press Check again."
  exit 1
fi

REPLY=$(printf '%s' "$CHAT" | jq -r '.response // ""')

case "$REPLY" in
  *"isn't wired up yet"*)
    # Only reachable on an image baked before the pastes were pre-baked
    # (2026-08-27). Kept so that failure names itself instead of looking like a
    # LaunchDarkly problem.
    fail-message "The app is running the old unwired stub, which means the lab image predates this version of the track. Tell your operator the image needs rebaking."
    exit 1 ;;
  *"isn't enabled"*)
    fail-message "Otto's Config evaluated to disabled. Ask Claude Code to set the default rule in the Test environment to serve otto-born."
    exit 1 ;;
  *"can't reach his model"*|*"overwhelmed"*|*"invalid setting"*|*"unexpected error"*)
    fail-message "Otto reached LaunchDarkly but could not call the model. This is a lab credentials problem, not something you did — tell your instructor. (Otto said: ${REPLY})"
    exit 1 ;;
  "")
    fail-message "Otto returned an empty response. Check the app log with \`journalctl -u togglewear -n 50\`, or tell your instructor."
    exit 1 ;;
esac

exit 0
