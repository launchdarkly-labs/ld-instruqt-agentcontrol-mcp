#!/bin/sh
#
# Assertions are deliberately loose on anything an agent gets to choose freely
# (display names, prompt wording, which flavour of the model-config key it
# picks) and strict on the things downstream challenges depend on: the config
# key, the variation key, and the fact that something is actually being served.
#

#
# NOTE: this is /bin/sh, which is dash on Ubuntu, and dash's builtin `echo`
# interprets backslash escapes. `echo "$JSON" | jq` therefore turns escaped \n
# inside JSON strings into real newlines and jq fails with "control characters
# must be escaped". Always `printf '%s' "$JSON" | jq`.
CONFIG_URL="https://app.launchdarkly.com/api/v2/projects/${LD_PROJECT_KEY}/ai-configs/otto-assistant"

# 1. The otto-assistant Config exists. Retry briefly: the learner may click
#    Check while the agent's last write is still settling.
i=0
while [ $i -lt 5 ]; do
  CONFIG=$(curl -s -X GET "$CONFIG_URL" \
    -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
    -H 'LD-API-Version: beta')
  [ "$(printf '%s' "$CONFIG" | jq -r '.key // "null"')" = "otto-assistant" ] && break
  i=$((i + 1))
  sleep 2
done

if [ "$(printf '%s' "$CONFIG" | jq -r '.key // "null"')" != "otto-assistant" ]; then
  fail-message "No Config with key **otto-assistant** exists yet. Ask Claude Code for it using the prompt under **Ask for Otto's Config** — and if it used a different key, tell it to use otto-assistant exactly."
  exit 1
fi

if [ "$(printf '%s' "$CONFIG" | jq -r '.mode // ""')" != "completion" ]; then
  fail-message "The **otto-assistant** Config isn't in completion mode. Ask Claude Code to recreate it in completion mode. Mode is fixed at creation time and can't be changed afterward."
  exit 1
fi

# 2. The otto-born variation exists and runs some flavour of Haiku 4.5. The
#    model-config key has several valid spellings (Bedrock.anthropic.claude-
#    haiku-4-5-20251001-v1:0, Anthropic.claude-haiku-4-5, ...) so match on the
#    family rather than one exact string.
VARIATION_MODEL=$(printf '%s' "$CONFIG" | jq -r '.variations[]? | select(.key=="otto-born") | .modelConfigKey // ""')
if [ -z "$VARIATION_MODEL" ]; then
  fail-message "Otto has no variation with key **otto-born**. Ask Claude Code to add it, using that exact key — the next challenge attaches a judge to it by key."
  exit 1
fi
if ! printf '%s' "$VARIATION_MODEL" | grep -qi 'haiku-4-5'; then
  fail-message "Otto's variation is running \`${VARIATION_MODEL}\`, not Claude Haiku 4.5. Ask Claude Code to switch it to anthropic.claude-haiku-4-5-20251001-v1:0."
  exit 1
fi

# 3. The variation has a non-empty system message. Wording isn't asserted.
SYSTEM_MSG=$(printf '%s' "$CONFIG" | jq -r '.variations[]? | select(.key=="otto-born") | .messages[]? | select(.role=="system") | .content' | head -c 1)
if [ -z "$SYSTEM_MSG" ]; then
  fail-message "Otto's variation has no system message. Ask Claude Code to add the starter prompt from the lab instructions."
  exit 1
fi

# 4. The `test` environment is actually serving otto-born rather than the
#    built-in disabled variation. Resolve the fallthrough index to a variation
#    id and compare ids, so a renamed variation doesn't break the check.
TARGETING=$(curl -s -X GET \
  "${CONFIG_URL}/targeting" \
  -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
  -H 'LD-API-Version: beta')
BORN_ID=$(printf '%s' "$CONFIG" | jq -r '.variations[]? | select(.key=="otto-born") | ._id // empty')
FALLTHROUGH_IDX=$(printf '%s' "$TARGETING" | jq -r '.environments.test.fallthrough.variation // empty')
FALLTHROUGH_ID=$(printf '%s' "$TARGETING" | jq -r ".variations[${FALLTHROUGH_IDX}]._id // empty")

if [ -z "$BORN_ID" ] || [ "$FALLTHROUGH_ID" != "$BORN_ID" ]; then
  fail-message "Otto's **Test** environment isn't serving the otto-born variation, so the app gets nothing back. Ask Claude Code to set the default rule in the Test environment to serve otto-born."
  exit 1
fi

# 5. The learner has pasted the SDK code into server.py.
if ! grep -q 'ai_client.completion_config(OTTO_CONFIG_KEY' /opt/ld/ai-configs-intro/app/server.py; then
  fail-message "Your server code still has the placeholder. Replace the **Challenge 01 paste block** in \`server.py\` with the code from the lab."
  exit 1
fi

exit 0
