#!/bin/sh

# Per-challenge setup for ch04 (guarded rollout).
#
# Two jobs, and one of them is not like the others.
#
# 1. Pre-create the Nova Pro model config, with -target so nothing else in the
#    module gets applied. The learner builds the variation and the rollout
#    through Claude Code — that's the chapter — but the model config's `name`
#    is load-bearing for the app: server.py resolves Bedrock model IDs out of
#    BEDROCK_MODEL_IDS keyed on the name LaunchDarkly returns, and passes
#    unknown names through verbatim. An agent that names it "Amazon Nova Pro"
#    produces a variation that looks correct everywhere and 400s at Bedrock the
#    moment it serves. Not a thing worth failing a learner on.
#
# 2. Start background traffic so the metric has something in it before the
#    learner starts the rollout. A guarded rollout with no baseline data sits
#    at stage one indefinitely.

set -e

cd /opt/ld/ai-configs-intro/terraform/challenge-04
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
terraform apply -auto-approve -target=launchdarkly_model_config.nova_pro

# The review-gate chapter's generator drives real /chat calls, which are
# expensive and no longer needed. background_traffic.py emits synthetic
# sessions with per-model brand-voice scores instead — much cheaper, and it
# biases Nova Pro low, which is what gives the rollout something to detect.
pkill -f realchat_traffic.py 2>/dev/null || true
pkill -f generate_traffic.py 2>/dev/null || true

if ! pgrep -f background_traffic.py > /dev/null; then
  nohup /opt/ld/ai-configs-intro/app/.venv/bin/python3 \
    /opt/ld/ai-configs-intro/traffic-generator/background_traffic.py \
    > /var/log/togglewear-bg-traffic.log 2>&1 &
fi

exit 0
