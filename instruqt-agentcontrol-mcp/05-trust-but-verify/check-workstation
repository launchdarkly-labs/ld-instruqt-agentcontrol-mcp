#!/bin/sh
#
# Validates the guarded rollout.
#
#   1. otto-assistant has an otto-stiff variation backed by a Nova model.
#   2. The brand-voice judge is attached to it, so the arm being tested is
#      actually being graded.
#   3. Something is splitting traffic on the test environment's fallthrough.
#   4. If that something is a recognisable guarded rollout, it watches
#      otto-brand-voice-score and rolls back on regression.
#
# Assertion 4 is conditional on purpose. See the HAS_GUARD block below.
#
# Not asserted: variation display names, the prompt wording, stage weights, or
# monitoring-window length. The agent gets to choose all of those.

#
# NOTE: this is /bin/sh, which is dash on Ubuntu, and dash's builtin `echo`
# interprets backslash escapes. `echo "$JSON" | jq` therefore turns escaped \n
# inside JSON strings into real newlines and jq fails with "control characters
# must be escaped". Always `printf '%s' "$JSON" | jq`.
API="https://app.launchdarkly.com/api/v2"

# ─── 1. The risky variation exists ─────────────────────────────────────────

i=0
while [ $i -lt 5 ]; do
  CONFIG=$(curl -fsS -X GET \
    "${API}/projects/${LD_PROJECT_KEY}/ai-configs/otto-assistant" \
    -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
    -H 'LD-API-Version: beta' 2>/dev/null)
  STIFF=$(printf '%s' "$CONFIG" | jq -r '.variations[]? | select(.key=="otto-stiff") | .key' 2>/dev/null)
  [ "$STIFF" = "otto-stiff" ] && break
  i=$((i + 1))
  sleep 2
done

if [ "$STIFF" != "otto-stiff" ]; then
  fail-message "No variation keyed **otto-stiff** on the otto-assistant Config. Ask Claude Code for it using the prompt under **Ask for the risky variation** — the key matters, because the sabotage script and this check both look for it."
  exit 1
fi

# Model family, not the exact model config key — the agent may have picked a
# differently-spelled Nova Pro, and any Nova is the risky arm in this lab.
STIFF_MODEL=$(printf '%s' "$CONFIG" | jq -r '.variations[]? | select(.key=="otto-stiff") | .modelConfigKey // ""')
case "$(printf '%s' "$STIFF_MODEL" | tr '[:upper:]' '[:lower:]')" in
  *nova*) : ;;
  *)
    fail-message "**otto-stiff** is backed by \`${STIFF_MODEL}\`, not a Nova model. The chapter needs a model that scores badly against the brand voice — ask Claude Code to point it at the existing Nova Pro model config named amazon.nova-pro-v1:0."
    exit 1 ;;
esac

# ─── 2. It's being graded ──────────────────────────────────────────────────
#
# A rollout watching a metric that nothing writes to for the test arm would
# never regress, and would look like a passing rollout rather than a broken
# one. Worth catching here rather than letting the learner wait it out.

JUDGED=$(printf '%s' "$CONFIG" | jq -r '
  .variations[]? | select(.key=="otto-stiff")
  | .judgeConfiguration.judges[]? | select(.judgeConfigKey=="otto-brand-voice-judge") | .judgeConfigKey' 2>/dev/null)

if [ "$JUDGED" != "otto-brand-voice-judge" ]; then
  fail-message "The **otto-brand-voice-judge** isn't attached to **otto-stiff**, so the arm you're testing isn't being graded the way otto-born is. Ask Claude Code to attach it at 100% sampling."
  exit 1
fi

# ─── 3. Traffic is being split ─────────────────────────────────────────────

i=0
while [ $i -lt 5 ]; do
  TARGETING=$(curl -fsS -X GET \
    "${API}/projects/${LD_PROJECT_KEY}/ai-configs/otto-assistant/targeting" \
    -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
    -H 'LD-API-Version: beta' 2>/dev/null)
  FALLTHROUGH=$(printf '%s' "$TARGETING" | jq -c '.environments.test.fallthrough // empty' 2>/dev/null)
  [ -n "$FALLTHROUGH" ] && break
  i=$((i + 1))
  sleep 2
done

HAS_ROLLOUT=$(printf '%s' "$FALLTHROUGH" | jq -r '.rollout // empty' 2>/dev/null)
if [ -z "$HAS_ROLLOUT" ]; then
  fail-message "The Test environment's default rule still serves a single variation, so no rollout is running. Start it in the LaunchDarkly tab: **Agents → Configs → Otto Assistant → Targeting**, confirm the environment is **Test**, click the **Default rule** and choose **Start guarded rollout**. Full steps are under **Start the guarded rollout**. The agent can't do this one — a guarded rollout has no API."
  exit 1
fi

# ─── 4. If it's a guarded rollout, check what it guards ────────────────────
#
# PERMISSIVE ON PURPOSE, and this is the soft spot in the check.
#
# Two reasons it can't simply require a guarded rollout:
#
#   * solve-workstation can only produce a plain percentage rollout. No public
#     REST instruction starts a guarded one (verified against the OpenAPI
#     spec — see terraform/challenge-04/main.tf). Requiring a guard here would
#     fail the operator's own Skip path.
#   * The response shape for a guarded rollout on this endpoint wasn't
#     confirmed against a live account at authoring time, so the detection
#     below is a best guess at the field names.
#
# So: if it looks like a guarded rollout, hold it to the standard. If it
# doesn't, accept the plain rollout and move on.
#
# VERIFY: run the learner path against a live account, capture the actual
# fallthrough JSON for a running guarded rollout, and replace this detection
# with the real field. Then decide whether to make the guard mandatory and
# give solve a documented reason to fail.

HAS_GUARD=$(printf '%s' "$FALLTHROUGH" | jq -r '
  .rollout | (.experimentAllocation // .guardedRollout // .measuredRollout // .releaseGuardian // empty) | if . == null then empty else "yes" end' 2>/dev/null)

if [ -n "$HAS_GUARD" ]; then
  GUARD=$(printf '%s' "$FALLTHROUGH" | jq -c '.rollout' 2>/dev/null)

  case "$GUARD" in
    *otto-brand-voice-score*) : ;;
    *)
      fail-message "The rollout is running but isn't watching **otto-brand-voice-score**. That's the metric your judge has been filling since the judge chapter — a rollout pointed at anything else has no data to regress on. Stop the rollout on the **Targeting** tab and start it again with that metric selected."
      exit 1 ;;
  esac

  case "$GUARD" in
    *'"rollback":true'*|*'"rollback": true'*|*rollbackOnRegression*) : ;;
    *)
      fail-message "The rollout watches the right metric but doesn't roll back on regression — it'll only notify. Restart it on the **Targeting** tab with **Roll back** selected under *On regression*."
      exit 1 ;;
  esac
fi

exit 0
