#!/bin/sh
#
# Validates tier-based model routing.
#
#   1. otto-assistant has an otto-premium variation on a Sonnet model.
#   2. A Test targeting rule matches the `tier` attribute against "premium"
#      and serves that variation.
#   3. The default rule still serves otto-born — a rule that swallowed the
#      fallthrough routes everyone to the expensive model and looks fine.
#   4. A real premium request actually gets Sonnet.
#
# Not asserted: rule description, rule position, the operator used (in/equals
# both work), or the variation's display name.

#
# NOTE: this is /bin/sh, which is dash on Ubuntu, and dash's builtin `echo`
# interprets backslash escapes. `echo "$JSON" | jq` therefore turns escaped \n
# inside JSON strings into real newlines and jq fails with "control characters
# must be escaped". Always `printf '%s' "$JSON" | jq`.
API="https://app.launchdarkly.com/api/v2"

# ─── 1. The premium variation ──────────────────────────────────────────────

i=0
while [ $i -lt 5 ]; do
  CONFIG=$(curl -fsS -X GET \
    "${API}/projects/${LD_PROJECT_KEY}/ai-configs/otto-assistant" \
    -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
    -H 'LD-API-Version: beta' 2>/dev/null)
  PREMIUM=$(printf '%s' "$CONFIG" | jq -r '.variations[]? | select(.key=="otto-premium") | .key' 2>/dev/null)
  [ "$PREMIUM" = "otto-premium" ] && break
  i=$((i + 1))
  sleep 2
done

if [ "$PREMIUM" != "otto-premium" ]; then
  fail-message "No variation keyed **otto-premium** on otto-assistant. Ask Claude Code for it using the prompt under **Ask for the variation** — the key matters, because this check and the next chapter both look for it."
  exit 1
fi

PREMIUM_MODEL=$(printf '%s' "$CONFIG" | jq -r '.variations[]? | select(.key=="otto-premium") | .modelConfigKey // ""')
case "$(printf '%s' "$PREMIUM_MODEL" | tr '[:upper:]' '[:lower:]')" in
  *sonnet*) : ;;
  *)
    fail-message "**otto-premium** is backed by \`${PREMIUM_MODEL}\`, which isn't a Sonnet model. The point of the chapter is that premium shoppers get a stronger model — ask Claude Code to point it at anthropic.claude-sonnet-4-5-20250929-v1:0."
    exit 1 ;;
esac

# ─── 2 & 3. The rule, and the fallthrough it must not have eaten ───────────

i=0
while [ $i -lt 5 ]; do
  TARGETING=$(curl -fsS -X GET \
    "${API}/projects/${LD_PROJECT_KEY}/ai-configs/otto-assistant/targeting" \
    -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
    -H 'LD-API-Version: beta' 2>/dev/null)
  RULES=$(printf '%s' "$TARGETING" | jq -c '.environments.test.rules // []' 2>/dev/null)
  [ -n "$RULES" ] && [ "$RULES" != "[]" ] && break
  i=$((i + 1))
  sleep 2
done

# Two lab-problem guards before any learner-blaming message, mirroring
# 02-otto-is-born. Without them a failed request or a missing `test` key falls
# through to the "no targeting rules" branch below, which tells the learner to
# ask the agent for something the agent already did. `curl -f` above means a
# non-2xx leaves TARGETING empty rather than holding a readable error body.
if ! printf '%s' "$TARGETING" | jq -e . >/dev/null 2>&1; then
  fail-message "Couldn't read otto-assistant's targeting from LaunchDarkly. That's a lab problem rather than anything you did — tell your operator."
  exit 1
fi

if [ "$(printf '%s' "$TARGETING" | jq -r 'has("environments") and (.environments | has("test"))')" != "true" ]; then
  ENVS=$(printf '%s' "$TARGETING" | jq -r '.environments // {} | keys | join(", ")')
  fail-message "otto-assistant has no **test** environment targeting. Environments found: \`${ENVS:-none}\`. This is a lab setup problem — tell your operator."
  exit 1
fi

# Resolve a variation KEY to an INDEX in the targeting endpoint's array.
#
# Confirmed against the published GET/PATCH targeting docs (2026-08-31):
#   https://launchdarkly.com/docs/api/agent-control/get-ai-config-targeting
#   https://launchdarkly.com/docs/api/agent-control/patch-ai-config-targeting
#
#   GET  /ai-configs/{key}            variations carry `key` AND `_id`
#   GET  /ai-configs/{key}/targeting  variations carry `_id`, `name`, `value`
#                                     and NO `key`. fallthrough.variation,
#                                     offVariation, targets[].variation, and
#                                     rollout.variations[].variation are
#                                     INTEGER INDICES into that array.
#   PATCH .../targeting               writes take `variationId`, a UUID
#
#   GET rules[] documents only `clauses` and `trackEvents`. It does not
#   document `variation` or `variationId`. The first two versions of this
#   check required those write-path fields on the read path, so a correctly
#   saved rule that matched the published schema failed 100% of the time.
#
# Join config -> targeting on `_id`, then `name`, then the config-array
# index (same order is the usual LD model). Matching `name` is not asserting
# a display name; it only lines the two arrays up.
resolve_idx() {
  jq -n --argjson cfg "$CONFIG" --argjson tgt "$TARGETING" --arg key "$1" '
    first($cfg.variations[]? | select(.key == $key)) as $v
    | ($cfg.variations | to_entries[] | select(.value.key == $key) | .key) as $cfg_idx
    | (
        [ ($tgt.variations // []) | to_entries[]
          | select(.value._id == $v._id or .value.name == $v.name)
          | .key ]
        | first
      ) // $cfg_idx // empty' 2>/dev/null
}

PREMIUM_IDX=$(resolve_idx otto-premium)
PREMIUM_VAR_ID=$(printf '%s' "$CONFIG" | jq -r 'first(.variations[]? | select(.key=="otto-premium") | ._id) // ""')

if [ -z "$PREMIUM_IDX" ]; then
  fail-message "Couldn't line up the **otto-premium** variation with otto-assistant's targeting. Ask Claude Code to show you otto-assistant's variations and confirm one is keyed exactly \`otto-premium\`."
  exit 1
fi

# GET rules document only `clauses` and `trackEvents` — no variation pointer.
# A live addRule that worked still failed Check when we required .variation /
# .variationId to equal otto-premium: the rule was on `tier` and the serve
# field was missing or not the write-path id. Match the clause; step 4 proves
# a premium request actually gets Sonnet.
# Docs: launchdarkly.com/docs/api/agent-control/get-ai-config-targeting
MATCHING=$(printf '%s' "$TARGETING" | jq '
  [.environments.test.rules[]?
    | select([.clauses[]?
        | select(.attribute == "tier")
        | select((.values | length) == 0
                 or ([.values[]? | ascii_downcase] | index("premium")))]
      | length > 0)
  ] | length' 2>/dev/null)

if [ "${MATCHING:-0}" -lt 1 ]; then
  # Distinguish "no rule at all" from "rule on the wrong attribute", because
  # the fix is different and the symptom is identical: nobody gets routed.
  #
  # By the time we reach here the response is known-good — the two guards above
  # ran, and PREMIUM_IDX resolved out of this same payload — so an empty rules
  # array means the rule was never saved, not that we misread it.
  ANY_RULE=$(printf '%s' "$TARGETING" | jq '[.environments.test.rules[]?] | length' 2>/dev/null)
  if [ "${ANY_RULE:-0}" -lt 1 ]; then
    fail-message "otto-assistant has no targeting rules in Test — the variation exists, but the rule was never saved. Work through the steps under **Add the rule**. The two most common misses are the environment selector not being on **Test**, and stopping after **Review and save** without clicking **Save changes**."
  else
    WRONG_ATTRS=$(printf '%s' "$TARGETING" | jq -r '[.environments.test.rules[]?.clauses[]?.attribute] | unique | join(", ")' 2>/dev/null)
    fail-message "There are targeting rules in Test, but none matches the **tier** attribute. Found rules on: \`${WRONG_ATTRS}\`. The app sets \`tier\` on the context — a rule on any other spelling matches nobody. Edit the rule on the **Targeting** tab so **Attribute** reads exactly \`tier\`, then **Review and save** and **Save changes**."
  fi
  exit 1
fi

BORN_IDX=$(resolve_idx otto-born)
FALLTHROUGH_ROLLOUT=$(printf '%s' "$TARGETING" | jq -c '.environments.test.fallthrough.rollout // empty')
FALLTHROUGH_HAS=$(printf '%s' "$TARGETING" | jq -r '.environments.test.fallthrough | has("variation")')

if [ "$FALLTHROUGH_HAS" != "true" ] && [ -n "$FALLTHROUGH_ROLLOUT" ]; then
  fail-message "The premium rule is in place, but the default rule is a percentage rollout rather than **otto-born**, so everyone is in a split. Ask Claude Code to set the default rule in Test to serve otto-born on its own."
  exit 1
fi

if [ -n "$BORN_IDX" ] && [ "$FALLTHROUGH_HAS" = "true" ]; then
  if ! printf '%s' "$TARGETING" | jq -e --argjson born "$BORN_IDX" \
       '.environments.test.fallthrough.variation == $born' >/dev/null 2>&1; then
    fail-message "The premium rule is in place, but the default rule no longer serves **otto-born** — so everyone, not just premium shoppers, is getting the expensive model. Ask Claude Code to set the default rule back to otto-born."
    exit 1
  fi
fi

# ─── 4. It actually routes ─────────────────────────────────────────────────
#
# Without this the check passes on a rule that reads correctly and never fires.

curl -s --max-time 60 -o /dev/null -X POST 'http://localhost:3000/chat' \
  -H 'Content-Type: application/json' \
  --data-raw '{"message":"Do the Toggle Socks come in large?","user_tier":"premium","session_id":"check-premium-routing"}'

ROUTED=$(journalctl -u togglewear --since '-2 min' 2>/dev/null \
  | grep 'chat session=check-premium-routing' | tail -1)

if [ -z "$ROUTED" ]; then
  fail-message "Otto didn't answer a premium request, so routing couldn't be verified. Confirm the ToggleWear service is running and that Challenge 01's paste block is still in \`server.py\` — an unwired Otto never evaluates the Config."
  exit 1
fi

case "$ROUTED" in
  *sonnet*) : ;;
  *)
    fail-message "A premium request was served by a model that isn't Sonnet. The rule exists but isn't taking effect. On the **Targeting** tab, open the rule and confirm its **Context kind** is **user** — the app builds a user context, and a rule on any other kind matches nobody. Saw: ${ROUTED}"
    exit 1 ;;
esac

exit 0
