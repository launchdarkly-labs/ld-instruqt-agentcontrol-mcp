#!/bin/bash

set -euo pipefail

until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
    echo "Waiting for instruqt bootstrap to complete"
    sleep 1
done

# ---------------------------------------------------------------------------
# Refresh the repo checkout to the pinned ref.
#
# The image bakes a git clone, so without this every edit to an assignment, a
# terraform module, or server.py needs a full re-bake. That is a brutal loop for
# content work. Refreshing here means a bake is only required when the *tools*
# on the image change (Claude Code, the AWS CLI, systemd units, the venv).
#
# REPO_REF is deliberately a branch during development. Pin it to a commit SHA
# for a delivery you want reproducible — otherwise a mid-session push to main
# changes what a running lab is serving.
#
# Failure here is non-fatal on purpose: if the network or the ref is bad we log
# it and continue with whatever the image baked, rather than killing the lab.
# ---------------------------------------------------------------------------
REPO_URL="https://github.com/launchdarkly-labs/ld-instruqt-agentcontrol-mcp.git"
REPO_REF="main"
REPO_DIR=/opt/ld/ai-configs-intro

refresh_repo() {
    # Clone to a temp dir and swap, rather than fetch-and-reset in place. Two
    # reasons: an image baked from a *different* repo can't be fast-forwarded to
    # this one, and a swap is atomic enough that a mid-clone failure leaves the
    # working checkout untouched.
    #
    # app/.venv is carried across the swap deliberately — it is built at bake
    # time and takes minutes to recreate, and togglewear.service dies without
    # it. .env and .mcp.json are carried because they hold this lab's live
    # credentials, written later in this script.
    local tmp="/opt/ld/.repo-incoming"
    rm -rf "$tmp"
    git clone --depth 1 --branch "${REPO_REF}" "${REPO_URL}" "$tmp" || return 1

    if [ -d "${REPO_DIR}" ]; then
        for keep in app/.venv app/.env app/.mcp.json; do
            if [ -e "${REPO_DIR}/${keep}" ]; then
                mkdir -p "$(dirname "$tmp/$keep")"
                mv "${REPO_DIR}/${keep}" "$tmp/$keep"
            fi
        done
        rm -rf "${REPO_DIR}.old"
        mv "${REPO_DIR}" "${REPO_DIR}.old"
    fi
    mv "$tmp" "${REPO_DIR}"
    rm -rf "${REPO_DIR}.old"
    # Authoring docs are the answer key; the image build strips them and a fresh
    # fetch brings them back. Strip again. See DECISIONS.md.
    rm -f "${REPO_DIR}"/CLAUDE.md "${REPO_DIR}"/DECISIONS.md "${REPO_DIR}"/PHASES.md \
          "${REPO_DIR}"/NARRATIVE.md "${REPO_DIR}"/OPERATOR-CHECKLIST-mcp.md
    # terraform init for anything the fetch added or changed.
    for ch in student-bootstrap challenge-01 challenge-02 challenge-03 challenge-04 challenge-05; do
        [ -d "${REPO_DIR}/terraform/${ch}" ] || continue
        (cd "${REPO_DIR}/terraform/${ch}" && terraform init -input=false -upgrade=false >/dev/null)
    done
}

if refresh_repo; then
    echo "Repo refreshed to ${REPO_REF} ($(git -C "${REPO_DIR}" rev-parse --short HEAD 2>/dev/null))"
else
    echo "WARNING: repo refresh failed; continuing with the image's baked checkout" >&2
fi

# ---------------------------------------------------------------------------
# Bedrock credentials.
#
# We use the static AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY Instruqt secrets,
# written into a boto3 profile named BedrockProfile because that is the profile
# name app/server.py and Claude Code both ask for.
#
# The GCP->AWS federation this repo documents does NOT work on an Instruqt
# workstation: the credential_process has to fetch a GCE instance identity token
# from metadata.google.internal, and that endpoint is unreachable here —
# `curl: (28) Operation timed out after 5002 milliseconds with 0 bytes received`,
# verified in a live lab 2026-08-14. No role ARN, audience, or trust-policy
# change can fix that, because the token can never be obtained in the first
# place. See DECISIONS.md.
#
# Trade-off, stated plainly: these are long-lived keys on a box the learner has
# a root shell on, so a learner can read them. Scope the IAM user to Bedrock
# invoke on the workshop's inference profiles and nothing else, and treat the
# keys as rotatable. That is a real downgrade from short-lived federated
# credentials — it is also the only thing that works.
# ---------------------------------------------------------------------------
mkdir -p /root/.aws

if [ -n "${AWS_ACCESS_KEY_ID:-}" ] && [ -n "${AWS_SECRET_ACCESS_KEY:-}" ]; then
    cat > /root/.aws/credentials <<EOF
[BedrockProfile]
aws_access_key_id = ${AWS_ACCESS_KEY_ID}
aws_secret_access_key = ${AWS_SECRET_ACCESS_KEY}
EOF
    chmod 600 /root/.aws/credentials

    # Deliberately no credential_process here. If the image baked one, this
    # overwrite removes it — a credential_process in config takes precedence
    # over a credentials file, so leaving it would keep the broken path.
    cat > /root/.aws/config <<EOF
[profile BedrockProfile]
region = ${AWS_REGION:-us-east-1}
EOF
    chmod 600 /root/.aws/config
    echo "BedrockProfile written from the static AWS secrets."
else
    echo "WARNING: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are not set." >&2
    echo "         Bedrock will not work, so Claude Code has no model and Otto" >&2
    echo "         cannot answer. Everything else still runs." >&2
fi

# ---------------------------------------------------------------------------
# Self-heal the tool layer.
#
# The image is supposed to ship Claude Code, the AWS CLI, the Claude Code
# pre-seed, and the Bedrock credential_process. If it doesn't — an old image, or
# one baked before those were added — install them now rather than failing
# challenge 00 with "Claude Code isn't installed on this workstation."
#
# Guarded on `claude` being absent, so a properly baked image skips this
# entirely and pays nothing. On an un-baked image it costs a couple of minutes
# at lab start, which is the correct trade against a lab that cannot work.
#
# BEDROCK_ROLE_ARN comes from an Instruqt secret when present. Without it the
# tools still install and everything except Bedrock works, so challenge 00
# passes and you learn what else is broken.
# ---------------------------------------------------------------------------
if ! command -v claude >/dev/null 2>&1; then
    echo "Claude Code not on this image — running the live bootstrap (this is slow)."
    if [ -x "${REPO_DIR}/vm-image/bootstrap-live.sh" ]; then
        BEDROCK_ROLE_ARN="${BEDROCK_ROLE_ARN:-}" \
        BEDROCK_JWT_AUDIENCE="${BEDROCK_JWT_AUDIENCE:-instruqt-agentcontrol}" \
        bash "${REPO_DIR}/vm-image/bootstrap-live.sh" \
          || echo "WARNING: bootstrap-live.sh reported problems; continuing" >&2
    else
        echo "WARNING: ${REPO_DIR}/vm-image/bootstrap-live.sh not found" >&2
    fi
else
    echo "Claude Code present ($(claude --version 2>/dev/null | head -1)) — skipping bootstrap."
fi

# The steps below and cleanup-workstation both cd to this path. Point it at the
# module in the refreshed repo, unconditionally.
#
# Three cases to survive: it may be absent (image baked before the symlink
# existed), a dangling symlink (repo dir was swapped), or a real directory
# holding a stale copy of the module. The last one is why this isn't a bare
# `ln -sfn` — linking onto an existing directory silently creates the link
# *inside* it, and then terraform runs against the stale copy.
TF_LINK=/opt/ld/terraform-ld-student
TF_TARGET="${REPO_DIR}/terraform/student-bootstrap"
if [ -d "$TF_TARGET" ]; then
    [ -L "$TF_LINK" ] && rm -f "$TF_LINK"
    [ -d "$TF_LINK" ] && rm -rf "$TF_LINK"
    ln -sfn "$TF_TARGET" "$TF_LINK"
else
    echo "WARNING: ${TF_TARGET} missing; leaving ${TF_LINK} as-is" >&2
fi

# Which LaunchDarkly account is this lab actually provisioning into? The team
# secret is described as belonging to workshops@launchdarkly.com, and knowing the
# account id decides whether the LaunchDarkly UI tab can ever show a learner
# their own project. Prints the id only, never the token.
echo "LD account for this lab: $(curl -sS https://app.launchdarkly.com/api/v2/caller-identity \
  -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" | jq -r '.accountId // "unknown"')"

cd /opt/ld/terraform-ld-student
echo "sandbox_id = \"${_SANDBOX_ID}\"" > terraform.tfvars
terraform apply -auto-approve
export LD_PROJECT_KEY="$(terraform output -json | jq -r '.students.value[0].project_key')"
echo "" >> ~/.profile
echo "export LD_PROJECT_KEY=\"$LD_PROJECT_KEY\"" >> ~/.profile
echo "" >> ~/.bashrc
echo "export LD_PROJECT_KEY=\"$LD_PROJECT_KEY\"" >> ~/.bashrc

export LD_CLIENT_KEY=$(curl -s -X GET \
  'https://app.launchdarkly.com/api/v2/projects/'${LD_PROJECT_KEY}'/environments/test' \
  -H 'Authorization: '${LAUNCHDARKLY_ACCESS_TOKEN}'' | jq -r ._id)
echo "export LD_CLIENT_KEY=${LD_CLIENT_KEY}" >> ~/.profile
echo "export LD_CLIENT_KEY=${LD_CLIENT_KEY}" >> ~/.bashrc

export LD_SDK_KEY=$(curl -s -X GET \
  'https://app.launchdarkly.com/api/v2/projects/'${LD_PROJECT_KEY}'/environments/test' \
  -H 'Authorization: '${LAUNCHDARKLY_ACCESS_TOKEN}'' | jq -r .apiKey)
echo "export LD_SDK_KEY=${LD_SDK_KEY}" >> ~/.profile
echo "export LD_SDK_KEY=${LD_SDK_KEY}" >> ~/.bashrc

# Mint a scoped API token restricted to this project only. The operator's
# LAUNCHDARKLY_ACCESS_TOKEN stays out of the participant's env; this
# per-lab token does double duty:
#   1. app-side REST calls from server.py
#   2. bearer auth for the LaunchDarkly MCP server, which the learner drives
#      from Claude Code (see the .mcp.json write below)
# The project is destroyed and this token revoked at cleanup.
#
# The inline role below looks fussy. Every part of it was established
# empirically, because the API rejects the obvious formulations:
#
#   * `proj/<key>:*` does NOT parse. There is no "everything under a project"
#     wildcard; each resource kind needs its own specifier.
#   * Each STATEMENT may only reference one kind of resource — mixing
#     `proj/<key>` and `proj/<key>:env/*` in one statement is a 400. Hence one
#     statement per kind.
#   * Flags, AgentControl configs, and segments are children of an ENVIRONMENT,
#     not of the project: `proj/<key>:env/*:flag/*`, not `proj/<key>:flag/*`.
#   * The AgentControl config kind is spelled `aiconfig`, all lowercase.
#     Without it, creating a Config returns 403 and challenge 01 is impossible.
#   * `ai-model-config` is documented but the parser rejects it, so it's
#     omitted. Model configs still resolve.
#
# The final `deny` is what actually contains the token. Allow statements only
# grant; they don't restrict. Without this deny, the token can list every
# project in the account and read their SDK keys — verified. It also makes
# challenge 00's "you should see exactly one project" true, which is what lets
# every prompt in the track say "my project" instead of naming a key.
# Failure here is the single most likely reason a lab won't start, and with
# `curl -fsS` under `set -e` it surfaces only as "Process exited with status 22".
# Capture the status and say what's actually wrong.
LD_TOKEN_HTTP=0
LD_TOKEN_JSON=$(curl -sS -w '\n%{http_code}' -X POST \
  "https://app.launchdarkly.com/api/v2/tokens" \
  -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
  -H "Content-Type: application/json" \
  --data-raw "$(jq -n \
    --arg name "Lab token: ${LD_PROJECT_KEY}" \
    --arg proj "${LD_PROJECT_KEY}" \
    '{
       name: $name,
       serviceToken: true,
       inlineRole: ((
         [
           "proj/\($proj)",
           "proj/\($proj):env/*",
           "proj/\($proj):env/*:flag/*",
           "proj/\($proj):env/*:aiconfig/*",
           "proj/\($proj):env/*:segment/*",
           "proj/\($proj):metric/*",
           "proj/\($proj):prompt-snippet/*"
         ]
         | map({effect: "allow", actions: ["*"], resources: [.]})
       ) + [
         {effect: "deny", actions: ["viewProject"], notResources: ["proj/\($proj)"]}
       ])
     }')")
LD_TOKEN_HTTP=$(printf '%s' "$LD_TOKEN_JSON" | tail -n1)
LD_TOKEN_JSON=$(printf '%s' "$LD_TOKEN_JSON" | sed '$d')

case "$LD_TOKEN_HTTP" in
  201|200) : ;;
  403)
    echo "" >&2
    echo "FATAL: could not mint the per-lab LaunchDarkly token (403)." >&2
    echo "  LaunchDarkly said: $(printf '%s' "$LD_TOKEN_JSON" | head -c 500)" >&2
    echo "" >&2
    echo "  The operator token needs permission to create access tokens. Note that" >&2
    echo "  a SERVICE token can only create other service tokens — which is why the" >&2
    echo "  request above sets serviceToken: true. Do not remove that field." >&2
    echo "" >&2
    exit 1 ;;
  *)
    echo "" >&2
    echo "FATAL: minting the per-lab LaunchDarkly token failed (HTTP ${LD_TOKEN_HTTP})." >&2
    echo "  Response: $(printf '%s' "$LD_TOKEN_JSON" | head -c 400)" >&2
    echo "" >&2
    exit 1 ;;
esac

LD_API_TOKEN=$(echo "$LD_TOKEN_JSON" | jq -r .token)
# Stash the token id so cleanup can revoke it. Without this every lab run
# leaks a live token that outlives the sandbox.
echo "$LD_TOKEN_JSON" | jq -r ._id > /opt/ld/.lab-token-id

APP_ENV=/opt/ld/ai-configs-intro/app/.env
sed -i 's|^LD_SDK_KEY=.*|LD_SDK_KEY='"${LD_SDK_KEY}"'|g' "$APP_ENV"
sed -i 's|^LD_CLIENT_KEY=.*|LD_CLIENT_KEY='"${LD_CLIENT_KEY}"'|g' "$APP_ENV"
sed -i 's|^LD_PROJECT_KEY=.*|LD_PROJECT_KEY='"${LD_PROJECT_KEY}"'|g' "$APP_ENV"
sed -i 's|^LD_API_TOKEN=.*|LD_API_TOKEN='"${LD_API_TOKEN}"'|g' "$APP_ENV"
sed -i 's|^AWS_REGION=.*|AWS_REGION='"${AWS_REGION}"'|g' "$APP_ENV"

# ---------------------------------------------------------------------------
# LaunchDarkly UI tab: provision this sandbox's SSO login.
#
# The `launchdarkly` virtual browser points at instruqt-login-redirector, which
# polls DynamoDB for a row keyed by sandbox id and redirects to that row's
# LoginUrl. Nothing wrote a row for our sandboxes, so the tab used to hang for
# 60 seconds and return 502. We write the two records it needs.
#
# The scheme, verified end to end against the live endpoint on 2026-08-17:
#   * a user record in instruqt-workshop-production-users, keyed on ProjectId,
#     holding LoginSecret / LoginExpiresAt / LoginEmail;
#   * a row in instruqt-workshop-production-sandbox mapping SandboxId to
#     {ProjectId, LoginUrl};
#   * LoginUrl = <api>/production/login?id=<ProjectId>&expires=<unix SECONDS>
#     &token=HMAC-SHA256(LoginSecret, "<ProjectId>.<expires>") in hex.
#
# `expires` is SECONDS, not milliseconds, even though the handler does
# `new Date(expires)`. Do not "correct" it: the handler also requires the value
# to be in the past when read as milliseconds, and a 10-digit seconds value
# satisfies that while a 13-digit millisecond value does not. Seconds is what
# the existing rows use and what works.
#
# This works only because the lab provisions into the same LaunchDarkly account
# the SAML recipient targets (652d7d3060...). If LAUNCHDARKLY_ACCESS_TOKEN is
# ever repointed at another account, the tab silently signs learners into an
# account without their project in it.
#
# These are shared production tables used by other workshops. We only ever write
# rows keyed by this sandbox's own ids, and cleanup-workstation deletes both.
#
# Non-fatal on purpose: if the IAM principal behind the AWS secrets cannot write
# these tables, the tab stays broken and the rest of the lab is unaffected.
# ---------------------------------------------------------------------------
# boto3, not the `aws` CLI. Nothing else in this lab shells out to the CLI --
# Bedrock goes through boto3 -- so the CLI is not guaranteed to be on the image,
# and a missing binary fails both writes identically and silently. boto3 is
# guaranteed: the app venv imports it, and check-image.sh asserts that.
#
# `env -u AWS_PROFILE` rather than `AWS_PROFILE=`: the image exports
# AWS_PROFILE=BedrockProfile for Bedrock, and an empty-string profile is not
# reliably treated as "unset" by botocore. Removing the variable outright makes
# boto3 fall through to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the
# Instruqt secrets, which is the principal that can write these tables.
provision_ld_login() {
    PY=/opt/ld/ai-configs-intro/app/.venv/bin/python3
    [ -x "$PY" ] || PY=python3

    env -u AWS_PROFILE \
        LD_PROJECT_KEY="$LD_PROJECT_KEY" \
        SANDBOX_ID="$_SANDBOX_ID" \
        "$PY" - <<'PY'
import hashlib, hmac, os, secrets, sys, time
import boto3

project = os.environ["LD_PROJECT_KEY"]
sandbox = os.environ["SANDBOX_ID"]
if not project or not sandbox:
    sys.exit(f"empty key: project={project!r} sandbox={sandbox!r}")

login_api = "https://nfiaf3w10f.execute-api.us-east-2.amazonaws.com/production/login"
login_secret = secrets.token_hex(16)
# Comfortably beyond the track's time limit so the link outlives the lab.
expires = int(time.time()) + 21600

ddb = boto3.client("dynamodb", region_name="us-east-2")

ddb.put_item(
    TableName="instruqt-workshop-production-users",
    Item={
        "ProjectId": {"S": project},
        "ProjectKey": {"S": project},
        "ProjectName": {"S": f"instruqt-workshop - {project}"},
        "LoginSecret": {"S": login_secret},
        "LoginExpiresAt": {"N": str(expires)},
        "LoginEmail": {"S": f"instruqt+{project}@launchdarkly.com"},
        "StudentEmail": {"S": "workshops@launchdarkly.com"},
        "StudentOrganizationKey": {"S": "workshop-org"},
    },
)

sig = hmac.new(
    login_secret.encode(), f"{project}.{expires}".encode(), hashlib.sha256
).hexdigest()

ddb.put_item(
    TableName="instruqt-workshop-production-sandbox",
    Item={
        "SandboxId": {"S": sandbox},
        "ProjectId": {"S": project},
        "LoginUrl": {"S": f"{login_api}?id={project}&expires={expires}&token={sig}"},
    },
)
PY
}

if provision_ld_login; then
    echo "LaunchDarkly UI tab provisioned for sandbox ${_SANDBOX_ID}."
else
    echo "WARNING: could not provision the LaunchDarkly UI tab. It will time out" >&2
    echo "         and show 502; everything else in the lab still works." >&2
    echo "         The boto3 traceback above names the cause. Identity in use:" >&2
    env -u AWS_PROFILE /opt/ld/ai-configs-intro/app/.venv/bin/python3 -c \
      'import boto3;print("        ",boto3.client("sts").get_caller_identity()["Arn"])' >&2 2>&1 || true
fi

# ---------------------------------------------------------------------------
# Point Claude Code at the LaunchDarkly MCP server.
#
# The token is written literally rather than as ${LD_API_TOKEN}. code-server
# runs from systemd as root and does not inherit the exports we appended to
# ~/.bashrc above, so an interpolated reference would resolve to an empty
# string in the learner's terminal.
#
# .mcp.json lives in the directory code-server opens as its workspace, which
# is also the cwd a learner lands in when they run `claude`.
# ---------------------------------------------------------------------------
APP_DIR=/opt/ld/ai-configs-intro/app

# Always regenerate from the template. Never sed -i the rendered file: a second
# run would find no placeholder and silently leave a stale token behind.
sed -e "s|__LD_API_TOKEN__|${LD_API_TOKEN}|g" \
    "${APP_DIR}/.mcp.json.example" > "${APP_DIR}/.mcp.json"
chmod 600 "${APP_DIR}/.mcp.json"

# The authoritative registration is the user-scope one in ~/.claude.json, baked
# with the same placeholder. A user-scope server needs no project approval, so
# it works from any directory and can't get stuck pending. Rewrite via jq so a
# malformed edit can't brick Claude Code.
CLAUDE_STATE=/root/.claude.json
if [ -f "$CLAUDE_STATE" ]; then
    TMP_STATE=$(mktemp)
    jq --arg tok "Bearer ${LD_API_TOKEN}" \
       '.mcpServers.LaunchDarkly.headers.Authorization = $tok' \
       "$CLAUDE_STATE" > "$TMP_STATE" && mv "$TMP_STATE" "$CLAUDE_STATE"
    chmod 600 "$CLAUDE_STATE"
fi

# First stop, then start the service. "restart" simply sends a "SIGHUP"
# which the app doesn't handle, so the new env vars aren't picked up until
# we do a full stop/start.
service togglewear stop
service togglewear start
