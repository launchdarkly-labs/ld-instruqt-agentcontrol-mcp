#!/bin/sh

# Per-challenge setup for ch03 (human review gate). Terraform init only; the
# learner does the work through Claude Code and a code paste. Solve applies.

set -e

cd /opt/ld/ai-configs-intro/terraform/challenge-03
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false

# Keep traffic flowing so there's something for the gate to act on.
if ! pgrep -f realchat_traffic.py > /dev/null; then
  nohup /opt/ld/ai-configs-intro/app/.venv/bin/python3 \
    /opt/ld/ai-configs-intro/traffic-generator/realchat_traffic.py \
    > /var/log/togglewear-realchat.log 2>&1 &
fi

exit 0
