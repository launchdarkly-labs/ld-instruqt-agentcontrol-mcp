#!/bin/sh
#
# Validates the learner has built the brand-voice judge end to end.
#
#   1. otto-brand-voice-judge Config exists, in judge mode.
#   2. Its variation prompt keeps the {{response}} template variable — without
#      it the judge grades nothing, and that failure is silent.
#   3. The judge is attached to otto-assistant/otto-born.
#   4. The otto-brand-voice-score metric exists.
#   5. server.py invokes the judge.
#
# Prompt wording beyond {{response}} is not asserted: the agent is free to
# reword the rubric, and challenge 03 only needs a score in 0.0-1.0.

#
# NOTE: this is /bin/sh, which is dash on Ubuntu, and dash's builtin `echo`
# interprets backslash escapes. `echo "$JSON" | jq` therefore turns escaped \n
# inside JSON strings into real newlines and jq fails with "control characters
# must be escaped". Always `printf '%s' "$JSON" | jq`.
API="https://app.launchdarkly.com/api/v2"

i=0
while [ $i -lt 5 ]; do
  JUDGE=$(curl -fsS -X GET \
    "${API}/projects/${LD_PROJECT_KEY}/ai-configs/otto-brand-voice-judge" \
    -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
    -H 'LD-API-Version: beta' 2>/dev/null)
  [ "$(printf '%s' "$JUDGE" | jq -r '.key // "null"')" = "otto-brand-voice-judge" ] && break
  i=$((i + 1))
  sleep 2
done

if [ "$(printf '%s' "$JUDGE" | jq -r '.key // "null"')" != "otto-brand-voice-judge" ]; then
  fail-message "No Config with key **otto-brand-voice-judge** exists yet. Ask Claude Code for it using the prompt under **Ask for the judge**, and make sure it uses that exact key."
  exit 1
fi

# The API requires the $ld:ai:judge: prefix on a judge's evaluationMetricKey,
# so an agent that supplies a bare name gets a 400 and creates nothing. If the
# config exists at all this has already passed, but assert it so a partially
# created judge fails with a useful message rather than a confusing one.
EVAL_KEY=$(printf '%s' "$JUDGE" | jq -r '.evaluationMetricKey // ""')
case "$EVAL_KEY" in
  '$ld:ai:judge:'*) : ;;
  *) fail-message "The judge's evaluation metric key is \`${EVAL_KEY}\`. LaunchDarkly requires it to start with \`\$ld:ai:judge:\` — ask Claude Code to set it to \`\$ld:ai:judge:otto-brand-voice-score\`."
     exit 1 ;;
esac

JUDGE_MODE=$(printf '%s' "$JUDGE" | jq -r '.mode // ""')
if [ "$JUDGE_MODE" != "judge" ]; then
  fail-message "**otto-brand-voice-judge** exists but its mode is \`${JUDGE_MODE}\`, not judge. Mode is fixed at creation, so ask Claude Code to delete it and recreate it in judge mode."
  exit 1
fi

SYSTEM_MSG=$(printf '%s' "$JUDGE" | jq -r '.variations[]? | .messages[]? | select(.role=="system") | .content' | head -c 8192)
if [ -z "$SYSTEM_MSG" ]; then
  fail-message "The judge has no variation with a system message. Ask Claude Code to add the Default variation with the grading prompt."
  exit 1
fi
if ! printf '%s' "$SYSTEM_MSG" | grep -q '{{response}}'; then
  fail-message "The judge's prompt is missing the **{{response}}** template variable, so it would grade an empty string. Ask Claude Code to add it back at the end of the prompt."
  exit 1
fi

# The judge has to be attached to the variation it grades.
#
# Read this from the CONFIG, not from the variation path. A GET on
# .../ai-configs/<key>/variations/<variationKey> returns HTTP 200 with a LIST
# ({"items":[...]}), so `.judgeConfiguration` is null at the top level and an
# attachment check against it always reads zero. Verified against the API.
# The config GET carries judgeConfiguration on each variation.
ATTACHED=$(curl -fsS -X GET \
  "${API}/projects/${LD_PROJECT_KEY}/ai-configs/otto-assistant" \
  -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
  -H 'LD-API-Version: beta' 2>/dev/null \
  | jq -r '[.variations[]? | select(.key=="otto-born") | .judgeConfiguration.judges[]? | select(.judgeConfigKey=="otto-brand-voice-judge")] | length')

if [ "${ATTACHED:-0}" -lt 1 ]; then
  fail-message "The judge isn't attached to Otto's **otto-born** variation, so LaunchDarkly doesn't know it grades Otto. Ask Claude Code to attach otto-brand-voice-judge to the otto-born variation of otto-assistant."
  exit 1
fi

METRIC=$(curl -s -o /dev/null -w '%{http_code}' \
  "${API}/metrics/${LD_PROJECT_KEY}/otto-brand-voice-score" \
  -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}")
if [ "$METRIC" != "200" ]; then
  fail-message "The **otto-brand-voice-score** metric doesn't exist. Ask Claude Code to create a numeric custom metric with key and event key \`otto-brand-voice-score\`, averaged, where higher is better."
  exit 1
fi

if ! grep -q 'otto-brand-voice-judge' /opt/ld/ai-configs-intro/app/server.py; then
  fail-message "Your server code doesn't invoke the judge yet. Replace the body of \`score_response()\` in \`server.py\` with the block from the assignment."
  exit 1
fi

# The stub returns None unconditionally. If it's still there, the judge never runs
# no matter what else is in the file.
if grep -q 'Challenge 02 judge: replace this body' /opt/ld/ai-configs-intro/app/server.py; then
  fail-message "\`score_response()\` still has its placeholder body. Replace the marker comment and the \`return None\` below it with the judge block from the assignment."
  exit 1
fi

# 6. The judge actually runs.
#
# Everything above proves the judge Config exists and the code is on disk. Ask
# Otto something and confirm the app really invoked the judge and got a usable
# score — otherwise this goes green while the judge silently fails on every
# request and the Monitoring chart the assignment sends you to stays empty.
curl -s --max-time 60 -o /dev/null -X POST 'http://localhost:3000/chat' \
  -H 'Content-Type: application/json' \
  --data-raw '{"message":"What is your return policy?","user_tier":"free","session_id":"check-ch02"}'

if journalctl -u togglewear --since '-2 min' 2>/dev/null | grep -q 'Brand-voice judge eval failed'; then
  DETAIL=$(journalctl -u togglewear --since '-2 min' 2>/dev/null | grep -A3 'Brand-voice judge eval failed' | tail -3)
  fail-message "The judge ran but threw an error, so no score was recorded. The app swallows judge failures on purpose, which is why Otto still replied. Details: ${DETAIL}"
  exit 1
fi

if ! journalctl -u togglewear --since '-2 min' 2>/dev/null | grep -q 'brand-voice-judge session='; then
  fail-message "Otto answered but the judge never produced a score. Confirm you replaced the body of \`score_response()\` (not just added to it), that the judge's targeting serves its Default variation, and that its prompt still ends with {{response}}."
  exit 1
fi

exit 0
